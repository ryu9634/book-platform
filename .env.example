# 이 파일을 .env 로 복사하고 값을 직접 정해서 넣습니다. (.env 는 git에 올리지 않음)
ORACLE_PASSWORD=
LIBRARY_DB_PASSWORD=
EBOOK_DB_PASSWORD=

# 도서관 관리자 앱이 처음 시작할 때 만드는 관리자 계정. 비워 두면 만들지 않습니다.
LIBRARY_ADMIN_LOGIN_ID=
LIBRARY_ADMIN_PASSWORD=

# 도서관 회원 앱 API의 JWT 서명 키. 32바이트 이상 무작위 문자열 (예: openssl rand -hex 32 결과)
LIBRARY_JWT_SECRET=

# 국립중앙도서관 ISBN 서지정보 API 인증키 (https://www.nl.go.kr 에서 발급). 비워 두면 ISBN 불러오기 대신 직접 입력
NL_API_KEY=

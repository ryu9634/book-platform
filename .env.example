# 이 파일을 .env 로 복사하고 값을 직접 정해서 넣습니다. (.env 는 git에 올리지 않음)
ORACLE_PASSWORD=
LIBRARY_DB_PASSWORD=
EBOOK_DB_PASSWORD=

# 도서관 관리자 앱이 처음 시작할 때 만드는 관리자 계정. 비워 두면 만들지 않습니다.
LIBRARY_ADMIN_LOGIN_ID=
LIBRARY_ADMIN_PASSWORD=

# 도서관 회원 앱 API의 JWT 서명 키. 32바이트 이상 무작위 문자열 (예: openssl rand -hex 32 결과)
LIBRARY_JWT_SECRET=

# 국립중앙도서관 서지 정보 제공 서비스 인증키 (공공데이터포털 https://www.data.go.kr/data/15154402/openapi.do 에서 활용신청). 비워 두면 ISBN 불러오기 대신 직접 입력
NL_API_KEY=

# ebook 관리자 앱이 처음 시작할 때 만드는 관리자 계정. 비워 두면 만들지 않습니다.
EBOOK_ADMIN_LOGIN_ID=
EBOOK_ADMIN_PASSWORD=

# ebook 회원 앱 API의 JWT 서명 키. 32바이트 이상 무작위 문자열
EBOOK_JWT_SECRET=

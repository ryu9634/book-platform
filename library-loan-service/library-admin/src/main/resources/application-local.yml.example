# 이 파일을 application-local.yml 로 복사해서 사용합니다. (application-local.yml 은 git에 올리지 않음)
spring:
  datasource:
    password:   # 루트 .env의 LIBRARY_DB_PASSWORD와 같은 값을 직접 넣습니다.
  jpa:
    properties:
      hibernate:
        format_sql: true

# 첫 관리자 계정. 루트 .env의 LIBRARY_ADMIN_LOGIN_ID, LIBRARY_ADMIN_PASSWORD와 같은 값을 직접 넣습니다.
library:
  # 국립중앙도서관 API 인증키. 루트 .env의 NL_API_KEY와 같은 값을 직접 넣습니다.
  nl-api:
    cert-key:
  admin:
    initial-login-id:
    initial-password:

logging:
  level:
    org.hibernate.SQL: debug
